# CrossPay API - local development settings.
# Copy to .env and replace every value. Never commit .env.

# PostgreSQL 15+ connection string. Use the migration role for npm run migrate
# and a least-privilege runtime role for the API process.
DATABASE_URL=postgres://crosspay_migrator:change-me@localhost:5432/crosspay
DATABASE_SSL=false

# 32 random bytes, base64 encoded: openssl rand -base64 32
# Used for application-level encryption of KYC, recipient and idempotency data.
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# 32 random bytes, base64 encoded: openssl rand -base64 32
# Signs short-lived access tokens. Refresh tokens are stored hashed in PostgreSQL.
JWT_SECRET=replace-with-a-32-byte-base64-key

# Provisional policy settings. Revisit after the post-build decision review.
KYC_RETENTION_DAYS=2555
LIMIT_TIMEZONE=UTC
IDEMPOTENCY_TTL_SECONDS=86400
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Pricing provider. "disabled" keeps rates/estimate/quote at an honest 503.
# "sandbox" uses the reference provider in kachi-fintech-sandbox.
PRICING_PROVIDER=disabled
# Required when PRICING_PROVIDER=sandbox.
SANDBOX_PRICING_URL=http://127.0.0.1:8080
SANDBOX_PRICING_KEY=
PRICING_TIMEOUT_MS=5000

# SMS delivery. "disabled" returns 503 SMS_NOT_CONFIGURED.
# "http" posts { recipient, message } to SMS_API_URL with x-api-key.
# The sandbox /v1/send-sms route is a compatible gateway.
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TIMEOUT_MS=5000
# Provisional sandbox SIM/device: +255767304776. Documentation/gateway check
# only; configure the SIM on the device, not in source code.
SMS_GATEWAY_PHONE=

# Payment provider. "disabled" keeps collections/payouts unavailable.
# "sandbox" targets the provider primitives in kachi-fintech-sandbox.
PAYMENT_PROVIDER=disabled
SANDBOX_PAYMENTS_URL=http://127.0.0.1:8080
SANDBOX_PAYMENTS_KEY=
PAYMENTS_TIMEOUT_MS=5000

# HTTP process
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated browser origins for the web preview. Leave empty for native
# apps only. Example: https://preview.crosspay.example
CORS_ORIGINS=
