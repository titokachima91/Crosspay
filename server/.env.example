# CrossPay API - local development settings.
# Copy to .env and replace every value. Never commit .env.

# PostgreSQL 15+ connection string. Use the migration role for npm run migrate
# and a least-privilege runtime role for the API process.
DATABASE_URL=postgres://crosspay_migrator:change-me@localhost:5432/crosspay
DATABASE_SSL=false

# 32 random bytes, base64 encoded: openssl rand -base64 32
# Used for application-level encryption of KYC, recipient and idempotency data.
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Provisional policy settings. Revisit after the post-build decision review.
KYC_RETENTION_DAYS=2555
LIMIT_TIMEZONE=UTC
IDEMPOTENCY_TTL_SECONDS=86400
