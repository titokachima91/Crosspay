<%- include('partials/header', { title: 'Liquidity', user, csrf, active: 'liquidity', notice, error, can }) %>
<div class="grid two">
  <div class="panel">
    <div class="panel-head"><h2>Liquidity providers</h2><span class="tag">allowlisted</span></div>
    <% if (providers.length === 0) { %><div class="empty">No providers.</div><% } else { %>
    <table>
      <thead><tr><th>Name</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% for (const p of providers) { %>
        <tr>
          <td><strong><%= p.name %></strong><div class="tag"><%= p.id %></div></td>
          <td><span class="pill <%= p.status === 'active' ? 'ok' : 'bad' %>"><%= p.status %></span></td>
          <td>
            <% if (can.liquidity) { %>
            <form method="post" action="/liquidity/providers/<%= p.id %>/status" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="status" value="<%= p.status === 'active' ? 'suspended' : 'active' %>">
              <button class="small <%= p.status === 'active' ? 'danger' : '' %>"><%= p.status === 'active' ? 'Suspend' : 'Activate' %></button>
            </form>
            <% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>
    <% if (can.liquidity) { %>
    <div class="divider"></div>
    <h3>Add provider</h3>
    <form method="post" action="/liquidity/providers">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="row">
        <div><label>Name</label><input name="name" required placeholder="Desk name"></div>
        <div class="shrink"><button class="primary">Create</button></div>
      </div>
    </form>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Prefunded orders</h2><span class="tag">minor units</span></div>
    <% if (orders.length === 0) { %><div class="empty">No orders.</div><% } else { %>
    <table>
      <thead><tr><th>Provider</th><th>Provide → Receive</th><th class="num">Remaining</th><th class="num">Rate</th><th>Status</th><th>Expires</th><th></th></tr></thead>
      <tbody>
      <% for (const o of orders) { %>
        <tr>
          <td><%= o.providerName %></td>
          <td><%= o.provideCurrency %> → <%= o.receiveCurrency %></td>
          <td class="num"><%= o.remainingMinor.toLocaleString('en-US') %> / <%= o.capacityMinor.toLocaleString('en-US') %></td>
          <td class="num"><%= o.rate %></td>
          <td><span class="pill <%= o.status === 'active' ? 'ok' : o.status === 'depleted' ? 'warn' : '' %>"><%= o.status %></span></td>
          <td><%= new Date(o.expiresAt).toISOString().replace('T',' ').slice(0,16) %></td>
          <td>
            <% if (can.liquidity && ['active','depleted','expired'].includes(o.status)) { %>
            <form method="post" action="/liquidity/orders/<%= o.id %>/cancel" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="small danger">Cancel</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
    <% } %>
    <% if (can.liquidity && providers.length > 0) { %>
    <div class="divider"></div>
    <h3>Add prefunded order</h3>
    <form method="post" action="/liquidity/orders">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="row">
        <div><label>Provider</label>
          <select name="providerId" required>
            <% for (const p of providers.filter((x) => x.status === 'active')) { %><option value="<%= p.id %>"><%= p.name %></option><% } %>
          </select>
        </div>
        <div><label>Provide currency</label><input name="provideCurrency" maxlength="3" required placeholder="KES"></div>
        <div><label>Receive currency</label><input name="receiveCurrency" maxlength="3" required placeholder="TZS"></div>
        <div><label>Capacity minor</label><input name="capacityMinor" type="number" min="1" required></div>
      </div>
      <div class="row" style="margin-top:10px">
        <div><label>Min per fill</label><input name="minAmountMinor" type="number" min="0" value="0"></div>
        <div><label>Max per fill</label><input name="maxAmountMinor" type="number" min="1" required></div>
        <div><label>Rate (receive minor per provide minor)</label><input name="rate" type="number" step="0.0000000001" min="0.0000000001" required placeholder="0.175"></div>
        <div><label>Expires at</label><input name="expiresAt" type="datetime-local" required></div>
      </div>
      <div class="row" style="margin-top:10px">
        <div><label>Prefund reference</label><input name="prefundReference" required placeholder="LP transfer / statement ref"></div>
        <div class="shrink"><button class="primary">Create and book prefund</button></div>
      </div>
      <p class="tag">Creating an order books 1000 cash / 2050 LP payable for the capacity. Verify the prefund before saving.</p>
    </form>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
