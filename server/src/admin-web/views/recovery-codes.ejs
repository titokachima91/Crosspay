<%- include('partials/header', { title: 'Recovery codes', user: null, csrf: '', active: '', notice: null, error: null }) %>
<div class="auth-card">
  <h1>Save your recovery codes</h1>
  <div class="sub">Each code can be used once if you lose your authenticator. Store them offline.</div>
  <div class="secret"><% for (const code of codes) { %><div><%= code %></div><% } %></div>
