{
  "name": "crosspay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CrossPay API and PostgreSQL data foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/http/start.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http/start.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "smoke:b2.3": "tsx scripts/smoke-b2.3.ts",
    "smoke:b2.4": "tsx scripts/smoke-b2.4.ts",
    "smoke:webhooks": "tsx scripts/smoke-webhooks.ts",
    "smoke:b4": "tsx scripts/smoke-b4.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=tap test/*.test.ts",
    "test:spec": "node --import tsx --test --test-concurrency=1 --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "embedded-postgres": "17.11.0-beta.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-x64@17.11.0-beta.19": true,
    "esbuild@0.28.2": true
  }
}
