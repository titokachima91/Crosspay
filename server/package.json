{
  "name": "crosspay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CrossPay API and PostgreSQL data foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/http/start.ts",
    "admin:dev": "tsx src/admin-web/server.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs'); for (const name of ['views','public']) fs.rmSync('dist/admin-web/'+name,{recursive:true,force:true}); fs.cpSync('src/admin-web/views','dist/admin-web/views',{recursive:true}); fs.cpSync('src/admin-web/public','dist/admin-web/public',{recursive:true})\"",
    "start": "node dist/http/start.js",
    "admin:start": "node dist/admin-web/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "smoke:b2.3": "tsx scripts/smoke-b2.3.ts",
    "smoke:b2.4": "tsx scripts/smoke-b2.4.ts",
    "smoke:webhooks": "tsx scripts/smoke-webhooks.ts",
    "smoke:b4": "tsx scripts/smoke-b4.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=tap test/*.test.ts",
    "test:spec": "node --import tsx --test --test-concurrency=1 --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/formbody": "^9.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.11",
    "@fastify/view": "^12.0.1",
    "argon2": "^0.45.2",
    "dotenv": "^17.2.3",
    "ejs": "^7.0.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "otpauth": "^9.6.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "17.11.0-beta.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-x64@17.11.0-beta.19": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.2": true
  }
}
